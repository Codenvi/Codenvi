<UserControl x:Class="Codenvi.Desktop.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" />
      <Button Content="Back" Click="OnClose" Margin="0" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Paired installs" Style="{StaticResource Heading}" />
        <DataGrid x:Name="InstallsGrid" Height="170">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="130" />
            <DataGridTextColumn Header="Last IP" Binding="{Binding LastIp}" Width="110" />
            <DataGridTextColumn Header="" Binding="{Binding Status}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,8,0,18">
          <Button Content="Revoke selected" Click="OnRevoke" />
          <Button Content="Rename selected" Click="OnRenameInstall" />
          <Button Content="Refresh" Click="OnRefresh" />
          <Button Content="Pair another PC" Click="OnPairPc" />
          <Button Content="Regenerate key" Click="OnRegenerateKey" />
        </WrapPanel>

        <TextBlock Text="This PC" Style="{StaticResource Heading}" />
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" />
        <CheckBox x:Name="MinimizeToTray" Content="Minimize to tray on close (jobs keep running)" />
        <CheckBox x:Name="AutoSwitchBranch" Content="Switch to the dev branch automatically when the tree is clean" />
        <CheckBox x:Name="DeleteTranscripts" Content="Delete old Claude transcripts when clearing or deleting a session" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
          <TextBlock Text="Max parallel projects" VerticalAlignment="Center" />
          <TextBox x:Name="MaxParallel" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" />
          <TextBlock Grid.Row="1" Text="Git author name" VerticalAlignment="Center" />
          <TextBox x:Name="GitName" Grid.Row="1" Grid.Column="1" Margin="0,4" />
          <TextBlock Grid.Row="2" Text="Git author email" VerticalAlignment="Center" />
          <TextBox x:Name="GitEmail" Grid.Row="2" Grid.Column="1" Margin="0,4" />
          <TextBlock Grid.Row="3" Text="Default dev branch" VerticalAlignment="Center" />
          <TextBox x:Name="DevBranch" Grid.Row="3" Grid.Column="1" Margin="0,4" />
          <TextBlock Grid.Row="4" Text="Stale job limit (hours)" VerticalAlignment="Center" />
          <TextBox x:Name="StaleHours" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" />
          <TextBlock Grid.Row="5" Text="Projects location" VerticalAlignment="Center" />
          <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseProjectsLocation" Margin="6,0,0,0" />
            <TextBox x:Name="ProjectsLocation" />
          </DockPanel>
        </Grid>
        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                   Text="Projects created from the Android app (+ on a device's project list) get a new folder in this location." />

        <TextBlock Text="Danger zone" Style="{StaticResource Heading}" Margin="0,20,0,8" />
        <Button Content="Disconnect this PC" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="OnDisconnect" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                   Text="Revokes this PC on the server and removes its tokens and keys from this PC. Your project folders and commits are not touched." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
