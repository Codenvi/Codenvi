<UserControl x:Class="Codenvi.Desktop.Views.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="24">
    <Button DockPanel.Dock="Bottom" Content="Back" HorizontalAlignment="Right" Click="OnClose" Margin="0,14,0,0" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Codenvi" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Primary}" />
        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,2,0,14" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <TextBlock x:Name="Disclaimer" />
        </Border>
        <TextBlock Text="License" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                   Text="MIT License. Copyright (c) 2026 Irakli Gzirishvili. See LICENSE in the repository." />
        <TextBlock Text="Repository" FontWeight="SemiBold" />
        <Button x:Name="RepoLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,14" Click="OnRepo" />
        <TextBlock Text="Website" FontWeight="SemiBold" />
        <Button x:Name="WebLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,14" Click="OnWebsite" />
        <TextBlock Text="Third-party notices" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" xml:space="preserve">.NET, WPF, Windows Forms, Microsoft.Extensions.*, Microsoft.Data.Sqlite - MIT (Microsoft)
CommunityToolkit.Mvvm - MIT (.NET Foundation)
Dapper - Apache-2.0 (Stack Exchange)
Serilog, Serilog.Sinks.File, Serilog.Extensions.Hosting - Apache-2.0 (Serilog contributors)
SQLite - public domain</TextBlock>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
