<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Codenvi contributors</Authors>
    <Product>Codenvi</Product>
    <RepositoryUrl>https://github.com/Codenvi/Codenvi</RepositoryUrl>
    <PackageProjectUrl>https://codenvi.github.io/Codenvi/</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Irakli Gzirishvili - MIT License</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
  </PropertyGroup>
</Project>
